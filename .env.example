# Copy to .env (never committed). All values are optional unless noted.

# Where FieldTheory keeps your bookmarks (defaults to ~/.ft-bookmarks)
BOOKMARK_SOURCE=
BOOKMARK_DB=
# File with CT0= and AUTH_TOKEN= lines for read-only thread unrolling
X_COOKIE_ENV=

# Classification (TypeSafe Jev) and chat (OpenRouter)
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Access: scrypt hash of the site password + a random session secret
#   node --input-type=module -e "import {hashPassword} from './lib/auth.mjs'; console.log(hashPassword('your password'))"
CORPUS_PASSWORD_HASH=
CORPUS_SESSION_SECRET=
# Bearer token for the MCP endpoint (/mcp)
CORPUS_MCP_TOKEN=
# Public URL (used as the OpenRouter referer)
CORPUS_PUBLIC_URL=
