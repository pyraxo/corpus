{
  "name": "corpus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server/main.mjs",
    "build:data": "node --no-warnings scripts/build-data.mjs",
    "check": "find server scripts public/js public/sw.js -name '*.mjs' -o -name '*.js' | xargs -n1 node --check",
    "backfill": "node --no-warnings scripts/backfill.mjs"
  },
  "main": "server/main.mjs"
}
